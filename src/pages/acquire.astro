---
import BaseLayout from "../layouts/BaseLayout.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { SITE } from "../config/site";

const title = "Acquire edesigrs.cloud | Premium Domain for Sale | eDesigrs";
const description =
  "Buy edesigrs.cloud now for $149,000 or make an offer. Escrow.com or Dan.com. Domain transfer only, from the owner in Phoenix.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
    { "@type": "ListItem", position: 2, name: "Acquire", item: `${SITE.url}/acquire/` },
  ],
};

const facts = [
  ["Asset", "The domain name only"],
  ["Price", `${SITE.priceLabel} USD, one time`],
  ["Protection", "Independent escrow before transfer"],
  ["Timing", "Typically 3–10 business days"],
  ["Seller", `Owner, ${SITE.location}`],
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:py-16">
    <header>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Available now</p>
      <h1 class="mt-3 font-serif text-5xl tracking-tight sm:text-6xl">Acquire edesigrs.cloud</h1>
      <p class="mt-4 text-lg text-mute">
        Listed at {SITE.priceLabel} USD. Buy now if that number works. Otherwise send an offer you can fund in escrow this month.
      </p>
      <dl class="mt-8 grid gap-4 text-sm">
        {facts.map(([term, detail]) => (
          <div class="grid grid-cols-[8rem_1fr] gap-3 border-b border-line pb-3">
            <dt class="text-mute">{term}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
    </header>
    <div class="rounded-2xl border border-line bg-surface p-5 sm:p-7">
      <h2 class="font-serif text-3xl tracking-tight">Start the close</h2>
      <p class="mb-6 mt-2 text-sm text-mute">The form prepares an email. It does not charge a card and it does not store what you type.</p>
      <InquiryForm intent="buy" />
    </div>
  </article>
</BaseLayout>
