---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GUIDES } from "../../config/copy";

const title = "Domain guides | edesigrs.cloud";
const description =
  "Notes on buying .cloud domains and reading a premium asking price, written for buyers of edesigrs.cloud.";
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">
      <a href="/" class="hover:underline">Home</a> / Guides
    </p>
    <h1 class="mt-3 font-serif text-5xl tracking-tight">Before you buy a premium name</h1>
    <p class="mt-4 text-mute">
      Two essays. They are here so the price is not the only sentence on the site, and so you can compare this name with the way .cloud actually gets used.
    </p>
    <label class="mt-8 grid gap-2 text-sm font-medium" for="guide-search">
      Search guides
      <input id="guide-search" class="min-h-12 rounded-xl border border-line bg-surface px-4 text-base font-normal" placeholder="escrow, .com, comps" />
    </label>
    <div class="mt-8 grid gap-4">
      {GUIDES.map((guide) => (
        <a
          href={`/guides/${guide.slug}/`}
          data-guide={`${guide.title} ${guide.description} ${guide.kicker}`.toLowerCase()}
          class="rounded-2xl border border-line p-6 hover:bg-surface"
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-accent">{guide.kicker} · {guide.minutes} min</p>
          <h2 class="mt-2 font-serif text-3xl tracking-tight">{guide.title}</h2>
          <p class="mt-2 text-sm text-mute">{guide.description}</p>
        </a>
      ))}
    </div>
    <p id="guide-empty" hidden class="mt-6 text-mute">No guide matches that search.</p>
  </div>
</BaseLayout>
