---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GUIDES } from "../../config/copy";
import { SITE } from "../../config/site";

export function getStaticPaths() {
  return GUIDES.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.title,
  description: guide.description,
  datePublished: SITE.updated,
  dateModified: SITE.updated,
  author: { "@type": "Organization", name: SITE.name },
  mainEntityOfPage: `${SITE.url}/guides/${guide.slug}/`,
};
---

<BaseLayout title={`${guide.title} | edesigrs.cloud`} description={guide.description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">
      <a href="/" class="hover:underline">Home</a> /
      <a href="/guides/" class="hover:underline">Guides</a>
    </p>
    <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-accent">{guide.kicker} · {guide.minutes} min</p>
    <h1 class="mt-3 font-serif text-5xl tracking-tight">{guide.title}</h1>
    <p class="mt-4 text-lg text-mute">{guide.description}</p>
    <div class="mt-10 grid gap-8">
      {guide.sections.map((section) => (
        <section>
          <h2 class="font-serif text-3xl tracking-tight">{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p class="mt-3 text-mute">{paragraph}</p>
          ))}
        </section>
      ))}
    </div>
    <p class="mt-12 border-t border-line pt-6 text-sm">
      The name discussed throughout is <a class="underline decoration-accent underline-offset-4" href="/acquire/">edesigrs.cloud, listed at {SITE.priceLabel}</a>.
    </p>
  </article>
</BaseLayout>
