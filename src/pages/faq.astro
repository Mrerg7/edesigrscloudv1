---
import BaseLayout from "../layouts/BaseLayout.astro";
import { FAQS } from "../config/copy";
import { SITE } from "../config/site";

const title = "FAQ | edesigrs.cloud Premium Domain for Sale";
const description =
  "Price, escrow, .cloud versus .com, and what a buyer of edesigrs.cloud actually receives. Straight answers from the owner.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      mainEntity: FAQS.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
        { "@type": "ListItem", position: 2, name: "FAQ", item: `${SITE.url}/faq/` },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">
      <a href="/" class="hover:underline">Home</a> / FAQ
    </p>
    <h1 class="mt-3 font-serif text-5xl tracking-tight">Common questions</h1>
    <p class="mt-4 text-mute">
      If your question is about a close, use the <a href="/acquire/" class="underline decoration-accent underline-offset-4">acquisition page</a>.
      These answers cover the name itself.
    </p>
    <div class="mt-10 grid gap-8">
      {FAQS.map((item) => (
        <section>
          <h2 class="text-xl font-semibold tracking-tight">{item.q}</h2>
          <p class="mt-2 text-mute">{item.a}</p>
        </section>
      ))}
    </div>
  </article>
</BaseLayout>
